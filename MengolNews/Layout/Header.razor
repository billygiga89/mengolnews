@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="header">
    <div class="container">
        <div class="brand">
            <img src="/images/Flamengo.png" alt="Flamengo" />
            <h1>MENGOLNEWS</h1>

            <!-- hora e clima — só desktop -->
            <div class="header-info" id="header-info">
                <span id="header-hora"></span>
                <span class="header-info-sep">·</span>
                <span id="header-clima">--°C</span>
            </div>

            <div class="social-icons social-icons-mobile">
                <a href="https://www.instagram.com/blackbillygiga/" target="_blank">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
                </a>
                <a href="https://www.youtube.com/&#64;MengolOficial" target="_blank">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M23 7s-.3-2-1.2-2.8c-1.1-1.2-2.4-1.2-3-1.3C16.6 2.8 12 2.8 12 2.8s-4.6 0-6.8.1c-.6.1-1.9.1-3 1.3C1.3 5 1 7 1 7S.7 9.2.7 11.3v2c0 2.1.3 4.3.3 4.3s.3 2 1.2 2.8c1.1 1.2 2.6 1.1 3.3 1.2C7.5 21.8 12 21.8 12 21.8s4.6 0 6.8-.2c.6-.1 1.9-.1 3-1.3.9-.8 1.2-2.8 1.2-2.8s.3-2.1.3-4.3v-2C23.3 9.2 23 7 23 7zM9.7 15.5V8.4l6.6 3.6-6.6 3.5z" /></svg>
                </a>
                <a href="https://www.tiktok.com/&#64;mengolnews" target="_blank">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 3.4A4.8 4.8 0 0 1 15 0h-3.4v16.5a2.9 2.9 0 0 1-2.9 2.6 2.9 2.9 0 0 1-2.9-2.9 2.9 2.9 0 0 1 2.9-2.9c.3 0 .5 0 .8.1V9.9a6.3 6.3 0 0 0-.8-.1 6.3 6.3 0 0 0-6.3 6.3A6.3 6.3 0 0 0 8.7 22.4a6.3 6.3 0 0 0 6.3-6.3V8.2a8.1 8.1 0 0 0 4.7 1.5V6.3a4.8 4.8 0 0 1-3.1-2.9h3.1z" /></svg>
                </a>
            </div>

            <button class="theme-toggle" @onclick="ToggleTheme" aria-label="Alternar tema" title="Alternar tema">
                <span class="theme-toggle-knob">
                    @if (isDark)
                    {
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" /></svg>
                    }
                </span>
            </button>
        </div>

        <nav class="nav @(menuAberto ? "nav-open" : "")">
            <button class="drawer-handle @(menuAberto ? "hide" : "")" @onclick="AbrirMenu" aria-label="Abrir menu"></button>

            <div class="nav-scroll">
                <NavLink href="/" Match="NavLinkMatch.All" @onclick="FecharMenu">
                    <span>Início</span>
                    <span class="nav-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5" /><path d="M5 9.5V21h5v-6h4v6h5V9.5" /></svg>
                    </span>
                </NavLink>
                <NavLink href="/noticias" @onclick="FecharMenu">
                    <span>Notícias</span>
                    <span class="nav-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h13a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4Z" /><path d="M8 8h8M8 12h8M8 16h4" /><path d="M19 8h2v11a1 1 0 0 1-1 1h-2" /></svg>
                    </span>
                </NavLink>
                <NavLink href="/videos" @onclick="FecharMenu">
                    <span>Vídeos</span>
                    <span class="nav-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="14" height="12" rx="2" /><path d="M16 10l6-3v10l-6-3" /></svg>
                    </span>
                </NavLink>
                <NavLink href="/serie-a" @onclick="FecharMenu">
                    <span>Brasileirão</span>
                    <span class="nav-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v4a4 4 0 0 1-8 0V4Z" /><path d="M8 5H5a2 2 0 0 0 2 4M16 5h3a2 2 0 0 1-2 4" /><path d="M10 14v3M14 14v3M8 21h8M9 17h6v4H9v-4Z" /></svg>
                    </span>
                </NavLink>
                <NavLink href="/elenco" @onclick="FecharMenu">
                    <span>Elenco</span>
                    <span class="nav-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4 4 7l2 3 2-1v11h8V9l2 1 2-3-4-3-2 2h-4L8 4Z" /></svg>
                    </span>
                </NavLink>
                <NavLink href="/artigos" @onclick="FecharMenu">
                    <span>Artigos</span>
                    <span class="nav-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" /><path d="M14 3v5h5" /><path d="M9 13h6M9 17h6" /></svg>
                    </span>
                </NavLink>
                <NavLink href="/sobre" @onclick="FecharMenu">
                    <span>Sobre</span>
                    <span class="nav-link-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                    </span>
                </NavLink>

                <div class="nav-footer">
                    <div class="nav-footer-brand">
                        <img src="/images/Flamengo.png" alt="Flamengo" />
                        <span>MENGOLNEWS</span>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Fundo escurecido atrás da gaveta — fecha o menu ao tocar fora -->
        <div class="nav-backdrop @(menuAberto ? "show" : "")" @onclick="FecharMenu"></div>

        <!-- Ícones desktop: fora do nav, no container -->
        <div class="social-icons social-icons-desktop">
            <a href="https://www.instagram.com/blackbillygiga/" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
            </a>
            <a href="https://www.youtube.com/&#64;MengolOficial" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M23 7s-.3-2-1.2-2.8c-1.1-1.2-2.4-1.2-3-1.3C16.6 2.8 12 2.8 12 2.8s-4.6 0-6.8.1c-.6.1-1.9.1-3 1.3C1.3 5 1 7 1 7S.7 9.2.7 11.3v2c0 2.1.3 4.3.3 4.3s.3 2 1.2 2.8c1.1 1.2 2.6 1.1 3.3 1.2C7.5 21.8 12 21.8 12 21.8s4.6 0 6.8-.2c.6-.1 1.9-.1 3-1.3.9-.8 1.2-2.8 1.2-2.8s.3-2.1.3-4.3v-2C23.3 9.2 23 7 23 7zM9.7 15.5V8.4l6.6 3.6-6.6 3.5z" /></svg>
            </a>
            <a href="https://www.tiktok.com/&#64;mengolnews" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 3.4A4.8 4.8 0 0 1 15 0h-3.4v16.5a2.9 2.9 0 0 1-2.9 2.6 2.9 2.9 0 0 1-2.9-2.9 2.9 2.9 0 0 1 2.9-2.9c.3 0 .5 0 .8.1V9.9a6.3 6.3 0 0 0-.8-.1 6.3 6.3 0 0 0-6.3 6.3A6.3 6.3 0 0 0 8.7 22.4a6.3 6.3 0 0 0 6.3-6.3V8.2a8.1 8.1 0 0 0 4.7 1.5V6.3a4.8 4.8 0 0 1-3.1-2.9h3.1z" /></svg>
            </a>
        </div>
    </div>
</header>
<NewsTicker />
@code {
    bool menuAberto = false;
    bool isDark = true;
    DotNetObjectReference<Header>? dotNetRef;

    void AbrirMenu() => menuAberto = true;
    void FecharMenu() => menuAberto = false;

    // Chamado pelo JS (drawer.js) quando o usuário completa o gesto de arrastar
    [JSInvokable]
    public void AbrirMenuJS()
    {
        menuAberto = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void FecharMenuJS()
    {
        menuAberto = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("mnTheme.get");
            isDark = theme != "light";
            StateHasChanged();

            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mnDrawer.init", dotNetRef);
        }
    }

    async Task ToggleTheme()
    {
        isDark = !isDark;
        await JS.InvokeVoidAsync("mnTheme.set", isDark ? "dark" : "light");
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef != null)
        {
            try { await JS.InvokeVoidAsync("mnDrawer.destroy"); } catch { }
            dotNetRef.Dispose();
        }
    }
}