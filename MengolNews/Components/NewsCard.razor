@using MengolNews.Models
@inject IJSRuntime JS

<article class="news-card">
    <img src="@ImagemFinal"
         alt="@Noticia.Titulo"
         loading="lazy"
         @onerror="OnImageError" />

    <!-- Compartilhar: ícone único, abre o compartilhamento nativo do aparelho -->
    <div class="news-share" @onclick:stopPropagation="true">
        @if (linkCopiado)
        {
            <span class="news-share-toast">Link copiado!</span>
        }
        <button type="button"
                class="news-share-btn"
                @onclick="Compartilhar"
                @onclick:stopPropagation="true"
                aria-label="Compartilhar notícia"
                title="Compartilhar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.6" y1="13.5" x2="15.4" y2="17.5"></line>
                <line x1="15.4" y1="6.5" x2="8.6" y2="10.5"></line>
            </svg>
        </button>
    </div>

    <div class="news-content">
        <h3>@Noticia.Titulo</h3>
    </div>

    <!-- Link real cobrindo o card inteiro (o Google segue <a href>, não @onclick) -->
    <a class="news-card-link" href="@HrefNoticia">
        <span class="news-card-link-texto">@Noticia.Titulo</span>
    </a>
</article>

@code {
    [Parameter, EditorRequired]
    public Noticia Noticia { get; set; } = default!;

    // imagem reservada para este card, escolhida pela página olhando a lista inteira
    // (se a página não passar nada, usa a escolha pelo título como antes)
    [Parameter]
    public string? ImagemFallback { get; set; }

    private bool linkCopiado;

    private string Fallback =>
        !string.IsNullOrWhiteSpace(ImagemFallback)
            ? ImagemFallback
            : FallbackImages.ObterPara(Noticia.Titulo);

    private string ImagemFinal =>
        string.IsNullOrWhiteSpace(Noticia.Imagem)
            ? Fallback
            : MengolNews.Services.ImageHelper.Proxy(Noticia.Imagem);

    private string HrefNoticia => Noticia.CaminhoSite;

    private string UrlNoSite => "https://www.mengolnews.com.br" + Noticia.CaminhoSite;

    private async Task Compartilhar()
    {
        var resultado = await JS.InvokeAsync<string>("mnShare", Noticia.Titulo, UrlNoSite);

        if (resultado == "copied")
        {
            linkCopiado = true;
            StateHasChanged();
            await Task.Delay(2000);
            linkCopiado = false;
            StateHasChanged();
        }
    }

    private void OnImageError()
    {
        Noticia.Imagem = Fallback;
        StateHasChanged();
    }
}