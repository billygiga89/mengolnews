@inject IJSRuntime JS

@if (carregado && !oculto)
{
    <div class="pix-float">
        <div class="pix-pilula"
             role="button"
             tabindex="0"
             aria-label="Apoie via Pix (abrir QR code)"
             aria-expanded="@(aberto ? "true" : "false")"
             @onclick="Alternar"
             @onkeydown="@(e => Tecla(e, Alternar))">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><path d="M14 14h3v3h-3zM19 14h2M14 19h2M19 19h2v2h-2z" /></svg>
            <span>Apoie via Pix</span>
        </div>

        <div class="pix-float-fechar"
             role="button"
             tabindex="0"
             title="Não mostrar mais"
             aria-label="Não mostrar mais"
             @onclick="Ocultar"
             @onkeydown="@(e => Tecla(e, Ocultar))">
            ×
        </div>

        @if (aberto)
        {
            <div class="pix-dropdown">
                <PixQr Flutuante="true" Titulo="Apoie via Pix" />
            </div>
        }
    </div>
}

@code {
    private const string ChaveStorage = "mn-pix-oculto";
    private static readonly TimeSpan TempoOculto = TimeSpan.FromDays(30);

    private bool carregado;   // só desenha depois de ler o storage (evita "piscar")
    private bool oculto;
    private bool aberto;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var valor = await JS.InvokeAsync<string?>("sessionStorage.getItem", ChaveStorage);
            if (long.TryParse(valor, out var quando))
            {
                var ate = DateTimeOffset.FromUnixTimeMilliseconds(quando) + TempoOculto;
                oculto = DateTimeOffset.UtcNow < ate;
            }
        }
        catch
        {
            // sem acesso ao storage: mostra normalmente
        }

        carregado = true;
    }

    private void Alternar() => aberto = !aberto;

    private void Ocultar()
    {
        aberto = false;
        oculto = true;
        _ = SalvarOcultoAsync();
    }

    private async Task SalvarOcultoAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", ChaveStorage,
                DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString());
        }
        catch
        {
            // falha silenciosa
        }
    }

    // Enter ou Espaço fazem o mesmo que o clique (acessibilidade)
    private void Tecla(KeyboardEventArgs e, Action acao)
    {
        if (e.Key == "Enter" || e.Key == " ") acao();
    }
}