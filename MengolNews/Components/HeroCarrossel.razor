@using NoticiaModel = MengolNews.Models.Noticia
@using MengolNews.Models
@using MengolNews.Components
@inject NavigationManager Nav
@implements IDisposable

@if (Noticias == null || !Noticias.Any())
{
    <section class="hero section">
        <img src="/images/Flamengo.png" alt="MengolNews" />
    </section>
}
else
{
    <section class="hero section hero-carrossel">
        <div class="carrossel-track" style="transform: translateX(-@(indiceAtual * 100)%);">
            @for (int i = 0; i < TotalSlides; i++)
            {
                var n = Slides[i];
                var imagem = ObterImagem(n);
                <div class="carrossel-slide" @onclick="() => AbrirNoticia(n)" style="cursor:pointer;">
                    <img src="@imagem" alt="@n.Titulo" />
                    <div class="carrossel-overlay"></div>
                    <div class="hero-content">
                        <h1>@n.Titulo</h1>
                        <time>@n.Data.ToShortDateString()</time>
                    </div>
                </div>
            }
        </div>
        <div class="hero-dots" @onclick:stopPropagation="true">
            @for (int i = 0; i < TotalSlides; i++)
            {
                var idx = i;
                <button class="hero-dot @(i == indiceAtual ? "active" : "")"
                        @onclick="() => IrPara(idx)">
                </button>
            }
        </div>
    </section>
}

@code {
    [Parameter] public List<NoticiaModel> Noticias { get; set; } = new();

    int indiceAtual = 0;
    int TotalSlides => Slides.Count;
    System.Threading.Timer? timer;

    // Mesmas imagens de fallback do NewsCard
    private static readonly string[] ImagensFlamengo = new[]
    {
        "/images/flamengo01.jpg",
        "/images/flamengo02.jpg",
        "/images/flamengo03.jpg",
        "/images/flamengo04.jpg",
        "/images/flamengo05.jpg",
        "/images/flamengo06.jpg",
        "/images/flamengo07.jpg",
        "/images/flamengo08.jpg",
        "/images/flamengo09.png",
    };

    private static readonly Random _rng = new();

    // Pega as 5 primeiras — com ou sem imagem
    List<NoticiaModel> Slides => Noticias.Take(5).ToList();

    private string ObterImagem(NoticiaModel n)
    {
        if (!string.IsNullOrWhiteSpace(n.Imagem))
            return n.Imagem;

        // Fallback aleatório igual ao NewsCard
        return ImagensFlamengo[_rng.Next(ImagensFlamengo.Length)];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TotalSlides > 0 && timer == null)
        {
            indiceAtual = 0;
            timer = new System.Threading.Timer(_ =>
            {
                if (TotalSlides > 0)
                    indiceAtual = (indiceAtual + 1) % TotalSlides;
                InvokeAsync(StateHasChanged);
            }, null, 5000, 5000);
        }
        await InvokeAsync(StateHasChanged);
    }

    void IrPara(int idx)
    {
        indiceAtual = idx;
        timer?.Change(5000, 5000);
        StateHasChanged();
    }

    void AbrirNoticia(NoticiaModel n)
    {
        var url = Uri.EscapeDataString(n.Link);
        Nav.NavigateTo($"/noticia?url={url}");
    }

    public void Dispose() => timer?.Dispose();
}
