@using NoticiaModel = MengolNews.Models.Noticia
@using MengolNews.Models
@using MengolNews.Components
@inject NavigationManager Nav
@implements IDisposable

@if (Noticias == null || !Noticias.Any())
{
    <section class="hero section">
        <img src="/images/Flamengo.png" alt="MengolNews" />
    </section>
}
else
{
    <section class="hero section hero-carrossel">
        <div class="carrossel-track" style="transform: translateX(-@(indiceAtual * 100)%);">
            @for (int i = 0; i < TotalSlides; i++)
            {
                var n = Slides[i];
                var imagem = ObterImagem(n);
                <div class="carrossel-slide @(EhFallback(n) ? "is-fallback" : "")" @onclick="() => AbrirNoticia(n)" style="cursor:pointer;">
                    <img src="@imagem" alt="@n.Titulo"
                         onerror="this.onerror=null; this.src='@FallbackImages.ObterPara(n.Titulo)';" />
                    <div class="carrossel-overlay"></div>
                    <div class="hero-content">
                        <h1>@n.Titulo</h1>
                        <time>@n.Data.ToShortDateString()</time>
                    </div>
                </div>
            }
        </div>
        <div class="hero-progress" @onclick:stopPropagation="true">
            @for (int i = 0; i < TotalSlides; i++)
            {
                var idx = i;
                var classe = idx == indiceAtual ? "ativo" : (idx < indiceAtual ? "completo" : "");
                <div class="hero-progress-bar @classe" style="--hero-slide-duration: 5s;" @onclick="() => IrPara(idx)">
                    <span class="hero-progress-fill"></span>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public List<NoticiaModel> Noticias { get; set; } = new();

    int indiceAtual = 0;
    int TotalSlides => Slides.Count;
    System.Threading.Timer? timer;

    // Pega as 5 primeiras — com ou sem imagem
    List<NoticiaModel> Slides => Noticias.Take(5).ToList();

    private bool EhFallback(NoticiaModel n) => string.IsNullOrWhiteSpace(n.Imagem);

    private string ObterImagem(NoticiaModel n)
    {
        if (!string.IsNullOrWhiteSpace(n.Imagem))
            return MengolNews.Services.ImageHelper.Proxy(n.Imagem);

        // Fallback estável — mesma notícia sempre mostra a mesma imagem,
        // não fica trocando sozinha a cada re-render do timer.
        return FallbackImages.ObterPara(n.Titulo);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TotalSlides > 0 && timer == null)
        {
            indiceAtual = 0;
            timer = new System.Threading.Timer(_ =>
            {
                if (TotalSlides > 0)
                    indiceAtual = (indiceAtual + 1) % TotalSlides;
                InvokeAsync(StateHasChanged);
            }, null, 5000, 5000);
        }
        await InvokeAsync(StateHasChanged);
    }

    void IrPara(int idx)
    {
        indiceAtual = idx;
        timer?.Change(5000, 5000);
        StateHasChanged();
    }

    void AbrirNoticia(NoticiaModel n)
    {
        var url = Uri.EscapeDataString(n.Link);
        Nav.NavigateTo($"/noticia?url={url}");
    }

    public void Dispose() => timer?.Dispose();
}