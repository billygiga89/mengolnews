@page "/artigos"
@using MengolNews.Services
@inject ArtigoService Servico

<PageTitle>Artigos e histórias do Flamengo | MengolNews</PageTitle>

<HeadContent>
    <meta name="description" content="Histórias aprofundadas do Flamengo: conquistas, momentos históricos e bastidores do Mengão, contados com detalhes e alma de torcedor." />
    <link rel="canonical" href="https://www.mengolnews.com.br/artigos" />
</HeadContent>

<div class="artigos-container">
    <h1 class="artigos-titulo">Artigos</h1>

    @if (carregando)
    {
        <p>Carregando...</p>
    }
    else if (artigos == null)
    {
        <p>Não foi possível carregar os artigos agora.</p>
        <div class="news-open-actions">
            <button @onclick="Recarregar">Tentar de novo</button>
        </div>
    }
    else if (!artigos.Any())
    {
        <p>Nenhum artigo publicado ainda.</p>
    }
    else
    {
        <div class="artigos-lista">
            @foreach (var artigo in artigos)
            {
                <a class="artigo-card" href="@($"/artigo/{artigo.Slug}")">
                    @if (!string.IsNullOrEmpty(artigo.Imagem))
                    {
                        <img src="@ImageHelper.Proxy(artigo.Imagem)" alt="@artigo.Titulo" class="artigo-card-imagem" />
                    }
                    <div class="artigo-card-conteudo">
                        <h2>@artigo.Titulo</h2>
                        <span class="artigo-card-data">@artigo.DataPublicacao.ToString("dd/MM/yyyy")</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<ArtigoDto>? artigos;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        // se já estiver na memória, termina na hora e a primeira renderização já vem com a lista
        artigos = await Servico.GetListaAsync();
        carregando = false;
    }

    private async Task Recarregar()
    {
        carregando = true;
        artigos = await Servico.GetListaAsync();
        carregando = false;
    }
}