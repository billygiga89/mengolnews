@page "/"
@inject MengolNews.Services.NewsApiService NewsService
@inject NavigationManager Nav
@using NoticiaModel = MengolNews.Models.Noticia
@using MengolNews.Components
@using MengolNews.Models

<PageTitle>Notícias do Flamengo hoje | MengolNews</PageTitle>

<HeadContent>
    <meta name="description" content="Últimas notícias do Flamengo, próximo jogo, resultados, tabela do Brasileirão e vídeos. Conteúdo rubro-negro com alma de torcedor no MengolNews." />
    <link rel="canonical" href="https://www.mengolnews.com.br/" />
</HeadContent>

@if (isLoading)
{
    <div class="content">
        <section class="news-list section">
            @for (int i = 0; i < 6; i++)
            {
                <SkeletonNewsCard />
            }
        </section>
    </div>
}
else if (!isLoading && noticias.Any())
{
    // Tudo que aparece na tela (5 slides do carrossel + cards da grade) recebe as
    // imagens de reserva de uma vez só, para não repetir e para a mesma notícia
    // ter a mesma imagem no carrossel e na grade.
    var visiveis = noticias.Take(10).ToList();
    var fallbacks = FallbackImages.Distribuir(
        visiveis.Select(n => (Chave: n.Titulo, Precisa: true)).ToList());

    <div class="content">
        <HeroCarrossel Noticias="noticias" Fallbacks="fallbacks" />
        <ProximoJogo />
        <section class="news-list section">
            @for (int i = 1; i < visiveis.Count; i++)
            {
                <NewsCard Noticia="visiveis[i]" ImagemFallback="@fallbacks[i]" />
            }
        </section>
    </div>
}
else
{
    <div class="content">
        <section class="news-list section">
            @for (int i = 0; i < 6; i++)
            {
                <SkeletonNewsCard />
            }
        </section>
    </div>
}

@code {
    private List<NoticiaModel> noticias = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var dados = await NewsService.GetNoticiasAsync();
            noticias = dados.OrderByDescending(n => n.Data).ToList();
            await InvokeAsync(StateHasChanged); // adiciona isso
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERRO AO BUSCAR NOTÍCIAS:");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AbrirNoticia(NoticiaModel noticia)
    {
        var url = Uri.EscapeDataString(noticia.Link);
        Nav.NavigateTo(noticia.CaminhoSite);
    }

    private string ImagemHero =>
        noticias.Any() && !string.IsNullOrWhiteSpace(noticias[0].Imagem)
            ? noticias[0].Imagem!
            : "/images/Flamengo.png";
}