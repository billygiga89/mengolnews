@page "/artigo/{Slug}"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>@(artigo?.Titulo ?? "Artigo") | MengolNews</PageTitle>

<HeadContent>
    @if (artigo != null)
    {
        <meta name="description" content="@MetaDescricao" />
        <link rel="canonical" href="@UrlCanonica" />

        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="MengolNews" />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:title" content="@artigo.Titulo" />
        <meta property="og:description" content="@MetaDescricao" />
        <meta property="og:image" content="@MetaImagem" />
        <meta property="og:url" content="@UrlCanonica" />
        <meta property="article:published_time" content="@DataIso" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@artigo.Titulo" />
        <meta name="twitter:description" content="@MetaDescricao" />
        <meta name="twitter:image" content="@MetaImagem" />

        <script type="application/ld+json">
                @((MarkupString)JsonLd)
        </script>
    }
</HeadContent>

<div class="artigo-container">
    @if (artigo == null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <h1 class="artigo-titulo">@artigo.Titulo</h1>
        <p class="artigo-data">@artigo.DataPublicacao.ToString("dd/MM/yyyy")</p>

        <div class="news-open-actions" style="margin-bottom: 1.5rem;">
            <button @onclick="Voltar">⬅ Voltar</button>
        </div>

        @if (!string.IsNullOrEmpty(artigo.Imagem))
        {
            <img src="@ImageHelper.Proxy(artigo.Imagem)" alt="@artigo.Titulo" class="artigo-imagem" />
        }

        <div class="artigo-corpo">
            @((MarkupString)artigo.ConteudoHtml)
        </div>

        <div class="news-open-actions" style="margin-top: 2.5rem;">
            <button @onclick="Voltar">⬅ Voltar</button>
        </div>
    }
</div>

@code {
    private const string SiteUrl = "https://www.mengolnews.com.br";

    [Parameter] public string Slug { get; set; } = "";
    private ArtigoDto? artigo;

    protected override async Task OnInitializedAsync()
    {
        artigo = await Http.GetFromJsonAsync<ArtigoDto>($"api/artigos/{Slug}");
    }

    private string UrlCanonica => $"{SiteUrl}/artigo/{Slug}";

    // Descrição = começo do texto do artigo (sem as tags HTML), com até ~160 caracteres
    private string MetaDescricao
    {
        get
        {
            var texto = System.Net.WebUtility.HtmlDecode(
                Regex.Replace(artigo?.ConteudoHtml ?? "", "<[^>]+>", " "));
            texto = Regex.Replace(texto, @"\s+", " ").Trim();

            if (string.IsNullOrEmpty(texto))
                return "Artigo sobre o Flamengo no MengolNews.";

            return texto.Length > 160 ? texto[..157].TrimEnd() + "..." : texto;
        }
    }

    // Imagem com endereço completo (a prévia de compartilhamento não aceita caminho relativo)
    private string MetaImagem
    {
        get
        {
            var img = artigo?.Imagem;
            if (string.IsNullOrWhiteSpace(img)) return $"{SiteUrl}/images/logo-canal.png";
            return img.StartsWith("/") ? SiteUrl + img : img;
        }
    }

    private string DataIso => artigo?.DataPublicacao.ToString("yyyy-MM-dd") ?? "";

    private string JsonLd
    {
        get
        {
            var schema = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "Article",
                ["headline"] = artigo?.Titulo ?? "",
                ["description"] = MetaDescricao,
                ["image"] = new[] { MetaImagem },
                ["datePublished"] = DataIso,
                ["dateModified"] = DataIso,
                ["inLanguage"] = "pt-BR",
                ["author"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Organization",
                    ["name"] = "MengolNews",
                    ["url"] = SiteUrl
                },
                ["publisher"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Organization",
                    ["name"] = "MengolNews",
                    ["logo"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "ImageObject",
                        ["url"] = $"{SiteUrl}/images/logo-canal.png"
                    }
                },
                ["mainEntityOfPage"] = new Dictionary<string, object?>
                {
                    ["@type"] = "WebPage",
                    ["@id"] = UrlCanonica
                }
            };

            return JsonSerializer.Serialize(schema);
        }
    }

    private void Voltar()
    {
        Nav.NavigateTo("/artigos");
    }
}