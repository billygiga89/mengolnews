@page "/noticia"
@using MengolNews.Models
@using System.Text.Json
@inject NavigationManager Nav
@inject MengolNews.Services.NewsApiService NewsService
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json.Serialization

<PageTitle>@(noticia?.Titulo ?? "Notícia") | MengolNews</PageTitle>

<HeadContent>
    @if (noticia != null)
    {
        <meta name="description" content="@MetaDescricao" />
        <link rel="canonical" href="@UrlCanonica" />

        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="MengolNews" />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:title" content="@noticia.Titulo" />
        <meta property="og:description" content="@MetaDescricao" />
        <meta property="og:image" content="@MetaImagem" />
        <meta property="og:url" content="@UrlCanonica" />
        <meta property="article:published_time" content="@DataIso" />
        <meta property="article:section" content="Flamengo" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@noticia.Titulo" />
        <meta name="twitter:description" content="@MetaDescricao" />
        <meta name="twitter:image" content="@MetaImagem" />

        <script type="application/ld+json">
                @((MarkupString)JsonLd)
        </script>
    }
</HeadContent>

<section class="section">

    @if (carregando)
    {
        <div class="news-open skeleton-detalhe">
            <div class="skeleton-img-detalhe"></div>
            <div class="skeleton-line title" style="width:60%; height:28px; margin: 16px 0;"></div>
            <div class="skeleton-line" style="width:100%;"></div>
            <div class="skeleton-line" style="width:95%;"></div>
            <div class="skeleton-line" style="width:90%;"></div>
            <div class="skeleton-line short" style="width:70%;"></div>
        </div>
    }
    else if (naoEncontrada)
    {
        <div class="news-open" style="text-align:center; padding: 3rem;">
            <p>⚠️ Notícia não encontrada.</p>
            <button @onclick="Voltar">⬅ Voltar</button>
        </div>
    }
    else if (noticia != null)
    {
        <article class="news-open">
            <img src="@ImagemFinal"
                 alt="@noticia.Titulo"
                 class="@(EhFallback ? "news-open-img news-open-img-fallback" : "news-open-img")"
                 onerror="this.onerror=null; this.src='@FallbackLocal'; this.classList.add('news-open-img-fallback');" />

            <div class="news-open-meta">
                <span class="news-open-date">@noticia.Data.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</span>
            </div>

            <h1 class="news-open-title">@noticia.Titulo</h1>
            <hr class="news-open-divider" />

            @BarraAcoes

            @if (carregandoConteudo)
            {
                @if (!string.IsNullOrWhiteSpace(noticia.Descricao))
                {
                    <p class="news-open-desc">@noticia.Descricao</p>
                }

                <div style="margin: 1.5rem 0;">
                    <div class="skeleton-line" style="width:100%;"></div>
                    <div class="skeleton-line" style="width:92%;"></div>
                    <div class="skeleton-line short" style="width:60%;"></div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(conteudoCompleto))
            {
                @foreach (var paragrafo in conteudoCompleto
                        .Split("\n\n")
                        .Where(p => !string.IsNullOrWhiteSpace(p)))
                {
                    <p>@paragrafo</p>
                }
            }
            else if (!string.IsNullOrEmpty(noticia.Descricao))
            {
                <p class="news-open-desc">@noticia.Descricao</p>
            }

            <PixQr />

            <div style="margin-top: 2.5rem;">
                @BarraAcoes
            </div>
        </article>
    }
</section>

@code {
    private Noticia? noticia;
    private string? conteudoCompleto;
    private bool carregando = true;
    private bool carregandoConteudo = false;
    private bool naoEncontrada = false;
    private bool linkCopiado = false;

    // Barra com "Voltar" à esquerda e "Compartilhar" à direita (usada no topo e no fim)
    private RenderFragment BarraAcoes => @<div class="news-open-actions news-open-actions-row">
        <button @onclick="Voltar">⬅ Voltar</button>

        <button type="button"
                class="news-open-share"
                aria-label="Compartilhar notícia"
                title="Compartilhar"
                @onclick="Compartilhar">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.6" y1="13.5" x2="15.4" y2="17.5"></line>
                <line x1="15.4" y1="6.5" x2="8.6" y2="10.5"></line>
            </svg>
            @if (linkCopiado)
            {
                <span class="news-open-share-msg">Link copiado!</span>
            }
        </button>
    </div>;

    private string UrlCanonica => noticia == null ? Nav.Uri : SiteUrl + noticia.CaminhoSite;

    private const string SiteUrl = "https://www.mengolnews.com.br";
    private const string ImagemPadrao = SiteUrl + "/images/Flamengo.png";

    private string MetaDescricao
    {
        get
        {
            var texto = !string.IsNullOrWhiteSpace(noticia?.Descricao)
                ? noticia!.Descricao
                : "Fique por dentro das últimas notícias do Flamengo no MengolNews.";

            texto = texto.Trim();
            return texto.Length > 160 ? texto[..157].TrimEnd() + "..." : texto;
        }
    }

    // Mesmo fallback do NewsCard (mesma chave: o título)
    private string FallbackLocal => FallbackImages.ObterPara(noticia?.Titulo ?? "");

    private bool EhFallback =>
        string.IsNullOrWhiteSpace(noticia?.Imagem) || noticia!.Imagem!.StartsWith("/");

    private string ImagemFinal =>
        string.IsNullOrWhiteSpace(noticia?.Imagem)
            ? FallbackLocal
            : MengolNews.Services.ImageHelper.Proxy(noticia!.Imagem!);

    private string MetaImagem
    {
        get
        {
            var img = string.IsNullOrWhiteSpace(noticia?.Imagem)
                ? FallbackLocal
                : noticia!.Imagem!;

            return img.StartsWith("/") ? SiteUrl + img : img;
        }
    }

    private string DataIso =>
        noticia?.Data.ToString("yyyy-MM-ddTHH:mm:sszzz") ?? DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:sszzz");

    private string JsonLd
    {
        get
        {
            var schema = new
            {
                context = "https://schema.org",
                type = "NewsArticle",
                headline = noticia?.Titulo ?? "",
                description = MetaDescricao,
                image = new[] { MetaImagem },
                datePublished = DataIso,
                dateModified = DataIso,
                author = new
                {
                    type = "Organization",
                    name = "MengolNews",
                    url = SiteUrl
                },
                publisher = new
                {
                    type = "Organization",
                    name = "MengolNews",
                    logo = new
                    {
                        type = "ImageObject",
                        url = SiteUrl + "/images/Flamengo.png"
                    }
                },
                mainEntityOfPage = new
                {
                    type = "WebPage",
                    id = UrlCanonica
                }
            };

            var opcoes = new JsonSerializerOptions { WriteIndented = false };
            var json = JsonSerializer.Serialize(schema, opcoes);

            json = json
                .Replace("\"context\":", "\"@context\":")
                .Replace("\"type\":", "\"@type\":")
                .Replace("\"id\":", "\"@id\":");

            return json;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);

        var parametros = uri.Query.TrimStart('?')
            .Split('&')
            .Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2)
            .ToDictionary(p => p[0], p => Uri.UnescapeDataString(p[1]), StringComparer.OrdinalIgnoreCase);

        parametros.TryGetValue("id", out var id);
        parametros.TryGetValue("url", out var link); // links antigos

        if (string.IsNullOrWhiteSpace(id) && string.IsNullOrWhiteSpace(link))
        {
            naoEncontrada = true;
            carregando = false;
            return;
        }

        var todas = await NewsService.GetNoticiasAsync();
        noticia = !string.IsNullOrWhiteSpace(id)
            ? todas.FirstOrDefault(n => n.Id == id)
            : todas.FirstOrDefault(n => n.Link == link);

        // Não achou na lista recente — tenta o arquivo permanente
        if (noticia == null)
            noticia = await BuscarNoArquivoAsync(id, link);

        carregando = false;

        if (noticia == null)
        {
            naoEncontrada = true;
            return;
        }

        await InvokeAsync(StateHasChanged);
        await CarregarConteudoCompleto(noticia);
    }

    private static string Consulta(string? id, string? link) =>
        !string.IsNullOrWhiteSpace(id)
            ? $"id={Uri.EscapeDataString(id)}"
            : $"url={Uri.EscapeDataString(link ?? "")}";

    private async Task<Noticia?> BuscarNoArquivoAsync(string? id, string? link)
    {
        try
        {
            var response = await Http.GetAsync($"api/noticias/arquivo?{Consulta(id, link)}");

            if (!response.IsSuccessStatusCode) return null;

            var json = await response.Content.ReadAsStringAsync();
            return JsonSerializer.Deserialize<Noticia>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });
        }
        catch
        {
            return null;
        }
    }

    private async Task CarregarConteudoCompleto(Noticia n)
    {
        carregandoConteudo = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await Http.GetAsync($"api/noticias/conteudo?{Consulta(n.Id, n.Link)}");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);

                if (doc.RootElement.TryGetProperty("conteudo", out var prop))
                    conteudoCompleto = prop.GetString();
            }
        }
        catch
        {
            // Silencioso — fallback para descrição já exibida
        }
        finally
        {
            carregandoConteudo = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Compartilhar()
    {
        if (noticia == null) return;

        var resultado = await JS.InvokeAsync<string>("mnShare", noticia.Titulo, UrlCanonica);

        if (resultado == "copied")
        {
            linkCopiado = true;
            StateHasChanged();
            await Task.Delay(2000);
            linkCopiado = false;
            StateHasChanged();
        }
    }

    private void Voltar()
    {
        Nav.NavigateTo("/noticias");
    }
}