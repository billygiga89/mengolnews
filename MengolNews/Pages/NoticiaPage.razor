@page "/noticia"
@using MengolNews.Models
@using System.Text.Json
@inject NavigationManager Nav
@inject MengolNews.Services.NewsApiService NewsService
@inject HttpClient Http
@using System.Text.Json.Serialization

<PageTitle>@(noticia?.Titulo ?? "Notícia") | MengolNews</PageTitle>

<HeadContent>
    @if (noticia != null)
    {
        <meta name="description" content="@MetaDescricao" />
        <link rel="canonical" href="@Nav.Uri" />

        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="MengolNews" />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:title" content="@noticia.Titulo" />
        <meta property="og:description" content="@MetaDescricao" />
        <meta property="og:image" content="@MetaImagem" />
        <meta property="og:url" content="@Nav.Uri" />
        <meta property="article:published_time" content="@DataIso" />
        <meta property="article:section" content="Flamengo" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@noticia.Titulo" />
        <meta name="twitter:description" content="@MetaDescricao" />
        <meta name="twitter:image" content="@MetaImagem" />

        <script type="application/ld+json">
            @((MarkupString)JsonLd)
        </script>
    }
</HeadContent>

<section class="section">

    @if (carregando)
    {
        <div class="news-open skeleton-detalhe">
            <div class="skeleton-img-detalhe"></div>
            <div class="skeleton-line title" style="width:60%; height:28px; margin: 16px 0;"></div>
            <div class="skeleton-line" style="width:100%;"></div>
            <div class="skeleton-line" style="width:95%;"></div>
            <div class="skeleton-line" style="width:90%;"></div>
            <div class="skeleton-line short" style="width:70%;"></div>
        </div>
    }
    else if (naoEncontrada)
    {
        <div class="news-open" style="text-align:center; padding: 3rem;">
            <p>⚠️ Notícia não encontrada.</p>
            <button @onclick="Voltar">⬅ Voltar</button>
        </div>
    }
    else if (noticia != null)
    {
        <article class="news-open">
            @if (!string.IsNullOrWhiteSpace(noticia.Imagem))
            {
                <img src="@MengolNews.Services.ImageHelper.Proxy(noticia.Imagem)"
                     alt="@noticia.Titulo"
                     class="@(noticia.Imagem.StartsWith("/") ? "news-open-img news-open-img-fallback" : "news-open-img")"
                     onerror="this.src='/images/Flamengo.png'; this.classList.add('news-open-img-fallback'); this.onerror=null;" />
            }

            <div class="news-open-meta">
                <span class="news-open-date">@noticia.Data.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</span>
            </div>

            <h1 class="news-open-title">@noticia.Titulo</h1>
            <hr class="news-open-divider" />

            <div class="news-open-actions">
                <button @onclick="Voltar">⬅ Voltar</button>
            </div>

            @if (carregandoConteudo)
            {
                <div style="margin: 1.5rem 0;">
                    <div class="skeleton-line" style="width:100%;"></div>
                    <div class="skeleton-line" style="width:95%;"></div>
                    <div class="skeleton-line" style="width:88%;"></div>
                    <div class="skeleton-line short" style="width:60%;"></div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(conteudoCompleto))
            {
                @foreach (var paragrafo in conteudoCompleto
                        .Split("\n\n")
                        .Where(p => !string.IsNullOrWhiteSpace(p)))
                {
                    <p>@paragrafo</p>
                }
            }
            else if (!string.IsNullOrEmpty(noticia.Descricao))
            {
                <p class="news-open-desc">@noticia.Descricao</p>
            }

            <div class="news-open-actions" style="margin-top: 2.5rem;">
                <button @onclick="Voltar">⬅ Voltar</button>
            </div>
        </article>
    }
</section>

@code {
    private Noticia? noticia;
    private string? conteudoCompleto;
    private bool carregando = true;
    private bool carregandoConteudo = false;
    private bool naoEncontrada = false;

    private const string SiteUrl = "https://www.mengolnews.com.br";
    private const string ImagemPadrao = SiteUrl + "/images/Flamengo.png";

    private string MetaDescricao
    {
        get
        {
            var texto = !string.IsNullOrWhiteSpace(noticia?.Descricao)
                ? noticia!.Descricao
                : "Fique por dentro das últimas notícias do Flamengo no MengolNews.";

            texto = texto.Trim();
            return texto.Length > 160 ? texto[..157].TrimEnd() + "..." : texto;
        }
    }

    private string MetaImagem =>
        !string.IsNullOrWhiteSpace(noticia?.Imagem) ? noticia!.Imagem! : ImagemPadrao;

    private string DataIso =>
        noticia?.Data.ToString("yyyy-MM-ddTHH:mm:sszzz") ?? DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:sszzz");

    private string JsonLd
    {
        get
        {
            var schema = new
            {
                context = "https://schema.org",
                type = "NewsArticle",
                headline = noticia?.Titulo ?? "",
                description = MetaDescricao,
                image = new[] { MetaImagem },
                datePublished = DataIso,
                dateModified = DataIso,
                author = new
                {
                    type = "Organization",
                    name = "MengolNews",
                    url = SiteUrl
                },
                publisher = new
                {
                    type = "Organization",
                    name = "MengolNews",
                    logo = new
                    {
                        type = "ImageObject",
                        url = SiteUrl + "/images/Flamengo.png"
                    }
                },
                mainEntityOfPage = new
                {
                    type = "WebPage",
                    id = Nav.Uri
                }
            };

            var opcoes = new JsonSerializerOptions { WriteIndented = false };
            var json = JsonSerializer.Serialize(schema, opcoes);

            // Corrige os nomes das propriedades reservadas do JSON-LD (@context, @type, @id)
            json = json
                .Replace("\"context\":", "\"@context\":")
                .Replace("\"type\":", "\"@type\":")
                .Replace("\"id\":", "\"@id\":");

            return json;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);

        var query = uri.Query.TrimStart('?');
        var parametros = query.Split('&')
            .Select(p => p.Split('='))
            .Where(p => p.Length == 2)
            .ToDictionary(p => p[0], p => Uri.UnescapeDataString(p[1]));

        if (!parametros.TryGetValue("url", out var link) || string.IsNullOrWhiteSpace(link))
        {
            naoEncontrada = true;
            carregando = false;
            return;
        }

        var todas = await NewsService.GetNoticiasAsync();
        noticia = todas.FirstOrDefault(n => n.Link == link);

        carregando = false;

        if (noticia == null)
        {
            naoEncontrada = true;
            return;
        }

        await InvokeAsync(StateHasChanged);
        await CarregarConteudoCompleto(link);
    }

    private async Task CarregarConteudoCompleto(string link)
    {
        carregandoConteudo = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var urlEncoded = Uri.EscapeDataString(link);
            var response = await Http.GetAsync($"api/noticias/conteudo?url={urlEncoded}");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);

                if (doc.RootElement.TryGetProperty("conteudo", out var prop))
                    conteudoCompleto = prop.GetString();
            }
        }
        catch
        {
            // Silencioso — fallback para descrição já exibida
        }
        finally
        {
            carregandoConteudo = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Voltar()
    {
        Nav.NavigateTo("/noticias");
    }
}
